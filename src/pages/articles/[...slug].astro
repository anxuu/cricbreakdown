---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const articles = await getCollection('articles');
  return articles.map(article => ({
    params: { slug: article.id },
    props: { article },
  }));
}

const { article } = Astro.props;
const { Content } = await render(article);

const categoryLabels: Record<string, string> = {
  ipl: 'IPL',
  stats: 'Stats',
  history: 'History',
  teams: 'Teams',
};

const siteUrl = 'https://www.cricbreakdown.com';
const canonicalUrl = new URL(`/articles/${article.id}/`, siteUrl).href;
const authorUrl = `${siteUrl}/author/${article.data.authorSlug}/`;
const formattedDate = article.data.pubDate.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });

const articleText = article.body ?? '';
const readTime = Math.max(1, Math.ceil(articleText.split(/\s+/).filter(Boolean).length / 220));

const faq = article.data.faq ?? [
  {
    question: 'How many players can RCB retain in IPL 2027?',
    answer: 'Since 2027 is a mini-auction, not a fresh mega-auction, RCB doesn’t get a new round of retentions. Their existing squad stays intact by default, and the only changes come from players they choose to release before the auction.',
  },
  {
    question: 'Who will be the captain of RCB in 2027?',
    answer: 'Rajat Patidar is expected to continue as captain heading into 2027. He’s led RCB to back-to-back titles, and there’s no real signal from the franchise suggesting a change at the top. The bigger conversations are around squad gaps, not leadership.',
  },
  {
    question: 'Which RCB players are in talks to be released in 2027?',
    answer: 'The names being talked about most are Yash Dayal, Suyash Sharma, Romario, and Jitesh, mainly due to underwhelming stats last season rather than any lack of talent.',
  },
  {
    question: 'Is Hardik Pandya coming to RCB in 2027?',
    answer: 'Unlikely. Reports suggest RCB have stayed out of the Hardik Pandya trade race, largely because his skillset overlaps with players they already have. Venkatesh Iyer, Krunal Pandya, Romario Shepherd, and Tim David all cover similar ground.',
  },
  {
    question: 'What will RCB’s 2027 jersey look like?',
    answer: 'There’s no official confirmation yet on a full redesign for 2027. What’s certain is that the 2-star badge added after their back-to-back titles in 2025 and 2026 will carry over, marking their consecutive championships. Beyond that, treat any other jersey leaks or mockups circulating online as speculation until RCB makes an official announcement.',
  },
];

const organizationId = `${siteUrl}/#organization`;
const personId = `${authorUrl}#person`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': organizationId,
      name: 'CricBreakdown',
      url: siteUrl,
      logo: `${siteUrl}/images/logo.svg`,
    },
    {
      '@type': 'Person',
      '@id': personId,
      name: article.data.author,
      url: authorUrl,
      worksFor: { '@id': organizationId },
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${canonicalUrl}#breadcrumb`,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: siteUrl },
        { '@type': 'ListItem', position: 2, name: categoryLabels[article.data.category] ?? article.data.category, item: `${siteUrl}/category/${article.data.category}/` },
        { '@type': 'ListItem', position: 3, name: article.data.title, item: canonicalUrl },
      ],
    },
    {
      '@type': 'BlogPosting',
      '@id': `${canonicalUrl}#article`,
      headline: article.data.title,
      description: article.data.description,
      url: canonicalUrl,
      mainEntityOfPage: { '@id': canonicalUrl },
      datePublished: article.data.pubDate.toISOString(),
      ...(article.data.updatedDate ? { dateModified: article.data.updatedDate.toISOString() } : {}),
      author: { '@id': personId },
      publisher: { '@id': organizationId },
      articleSection: categoryLabels[article.data.category] ?? article.data.category,
      keywords: article.data.tags,
      inLanguage: 'en',
    },
    {
      '@type': 'FAQPage',
      '@id': `${canonicalUrl}#faq`,
      mainEntity: faq.map(item => ({
        '@type': 'Question',
        name: item.question,
        acceptedAnswer: { '@type': 'Answer', text: item.answer },
      })),
    },
  ],
};
---
<Layout
  title={article.data.metaTitle ?? article.data.title}
  description={article.data.metaDescription ?? article.data.description}
  canonical={canonicalUrl}
  type="article"
  author={article.data.author}
  authorUrl={authorUrl}
  publishedTime={article.data.pubDate.toISOString()}
  modifiedTime={article.data.updatedDate?.toISOString()}
  category={categoryLabels[article.data.category] ?? article.data.category}
  keywords={article.data.tags}
  image={article.data.cover}
  imageAlt={article.data.coverAlt}
  readTime={readTime}
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <article class="max-w-3xl mx-auto px-5 md:px-8 pt-10 pb-20" itemscope itemtype="https://schema.org/BlogPosting">
    <header>
      <nav aria-label="Breadcrumb" class="mb-5 text-xs text-ink/50">
        <ol class="flex flex-wrap items-center gap-2">
          <li><a href="/" class="hover:text-leather">Home</a></li>
          <li aria-hidden="true">/</li>
          <li><a href={`/category/${article.data.category}`} class="hover:text-leather">{categoryLabels[article.data.category] ?? article.data.category}</a></li>
          <li aria-hidden="true">/</li>
          <li aria-current="page" class="text-ink/70">Article</li>
        </ol>
      </nav>

      <div class="flex flex-wrap items-center gap-3 mb-5">
        <span class="stat-chip text-[11px] uppercase tracking-wider text-leather bg-leather/10 px-2 py-1 rounded">{categoryLabels[article.data.category] ?? article.data.category}</span>
        <time class="text-xs text-ink/40" datetime={article.data.pubDate.toISOString()} itemprop="datePublished">{formattedDate}</time>
        <span class="text-xs text-ink/40">· By <a href={authorUrl} rel="author" class="hover:text-leather" itemprop="author">{article.data.author}</a></span>
        <span class="text-xs text-ink/40">· {readTime} min read</span>
      </div>

      <h1 class="font-display font-bold text-3xl md:text-5xl leading-tight text-pitch mb-6" itemprop="headline">{article.data.title}</h1>

      <p class="text-lg text-ink/60 leading-relaxed mb-10 border-l-2 border-leather pl-4" itemprop="description">{article.data.description}</p>

      <div class="seam mb-10" aria-hidden="true"></div>
    </header>

    <div class="prose prose-lg max-w-none prose-headings:font-display prose-headings:text-pitch prose-a:text-leather prose-strong:text-pitch" itemprop="articleBody">
      <Content />
    </div>

    <footer class="mt-14 pt-8 border-t border-pitch-2/10">
      <ul class="flex flex-wrap gap-2" aria-label="Article tags">
        {article.data.tags.map(tag => <li><span class="text-xs text-ink/50 bg-pitch-2/5 px-3 py-1 rounded-full">{tag}</span></li>)}
      </ul>
    </footer>
  </article>
</Layout>
