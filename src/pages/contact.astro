---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Contact" description="Get in touch with CricBreakdown.">
  <section class="max-w-2xl mx-auto px-5 md:px-8 pt-16 pb-24">
    <span class="stat-chip text-xs uppercase tracking-widest text-leather">Contact</span>
    <h1 class="font-display font-bold text-3xl md:text-5xl text-pitch mt-2 mb-8">
      Get in touch
    </h1>
    <p class="text-ink/65 leading-relaxed mb-8">
      Spotted an error in a breakdown? Have a stat you think we should dig into?
      Want to suggest a team or topic? Reach out — every message is read.
    </p>
    <div class="bg-white border border-pitch-2/10 rounded-lg p-6">
      <p class="text-sm text-ink/50 mb-1">Email</p>
      <a href="mailto:hello@cricbreakdown.com" class="text-lg font-medium text-leather">
        hello@cricbreakdown.com
      </a>
      <p class="text-xs text-ink/40 mt-4">
        Replace this with your real inbox before launch — this address is a placeholder.
      </p>
    </div>
  </section>
</Layout>
