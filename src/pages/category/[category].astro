---
import Layout from '../../layouts/Layout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  return [
    { params: { category: 'ipl' }, props: { label: 'IPL', desc: 'Season breakdowns, auction economics, team-by-team analysis.' } },
    { params: { category: 'international' }, props: { label: 'International', desc: 'Series reviews, Test and T20 analysis across every format.' } },
    { params: { category: 'stats' }, props: { label: 'Stats', desc: 'Numbers-first analysis — no narrative without the data behind it.' } },
    { params: { category: 'history' }, props: { label: 'Cricket Chronicles', desc: 'Stories, retrospectives and great moments from cricket\u2019s long memory.' } },
    { params: { category: 'teams' }, props: { label: 'Teams', desc: 'Franchise and national side deep-dives.' } },
  ];
}

const { category } = Astro.params;
const { label, desc } = Astro.props;

const articles = (await getCollection('articles', a => a.data.category === category)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---
<Layout title={label} description={desc}>
  <section class="max-w-6xl mx-auto px-5 md:px-8 pt-16 pb-10">
    <span class="stat-chip text-xs uppercase tracking-widest text-[#E94560]">Category</span>
    <h1 class="font-display font-bold text-3xl md:text-4xl text-pitch mt-2">{label}</h1>
    <p class="text-ink/60 mt-3 max-w-lg">{desc}</p>
  </section>
  <div class="seam max-w-6xl mx-auto"></div>
  <section class="max-w-6xl mx-auto px-5 md:px-8 py-12">
    {articles.length > 0 ? (
      <div class="grid md:grid-cols-3 gap-5">
        {articles.map(a => (
          <ArticleCard
            slug={a.id}
            title={a.data.title}
            description={a.data.description}
            category={a.data.category}
            pubDate={a.data.pubDate}
            cover={a.data.cover}
            coverAlt={a.data.coverAlt}
          />
        ))}
      </div>
    ) : (
      <p class="text-ink/50">No breakdowns published in this category yet — check back soon.</p>
    )}
  </section>
</Layout>
