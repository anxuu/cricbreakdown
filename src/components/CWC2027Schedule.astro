  .chip-india { background: #fff0f3; color: var(--c-coral-h); }
  .chip-confirmed { background: var(--c-blue); color: #fff; }
  .chip-assumed { background: #fff0f3; color: var(--c-coral-h); border: 1px dashed var(--c-coral); }
