  }
  .fx-list { list-style: none; margin: 0.75rem 0 0; padding: 0; display: grid; gap: 0.75rem; }

  /* Fixture card */
  .fx {
    display: grid; gap: 0.75rem; min-width: 0; padding: 0.9rem 1rem;
