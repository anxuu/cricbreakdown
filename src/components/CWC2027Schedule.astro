  @media (min-width: 768px) { .fx { padding: 1.1rem 1.25rem; } .fx[data-india='1'] { padding-left: calc(1.25rem - 3px); } }
  .fx-top { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 0.5rem; }
