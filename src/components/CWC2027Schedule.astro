  .fx-foot { display: grid; gap: 0.6rem; padding-top: 0.75rem; border-top: 1px solid var(--c-line); min-width: 0; }
  @media (min-width: 640px) { .fx-foot { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 1.5rem; } }
  .fx-venue { margin: 0; display: flex; align-items: flex-start; gap: 0.4rem; font-size: 0.9rem; }
  .fx-venue svg { flex: none; margin-top: 0.15rem; color: var(--c-coral); }
  .fx-stream { font-size: 0.85rem; color: var(--c-muted); }
  .fx-stream p { margin: 0; }
  .fx-stream-title {
    font-family: var(--font-mono, 'JetBrains Mono', monospace); font-size: 0.68rem !important;
    letter-spacing: 0.06em; text-transform: uppercase; margin-bottom: 0.1rem !important;
  }
  .fx-stream .k {
    display: inline-block; min-width: 3.4rem; font-family: var(--font-mono, 'JetBrains Mono', monospace);
    font-size: 0.68rem; letter-spacing: 0.06em; text-transform: uppercase;
  }
  .fx-stream p:not(.fx-stream-title) { color: var(--c-navy); font-weight: 500; }
  .fx-result {
    margin: 0; padding: 0.5rem 0.75rem; border-radius: 8px; background: var(--c-bg);
    font-size: 0.9rem; font-weight: 600;
  }

  /* Empty state */
  .cwc-empty {
    margin-top: 1.5rem; padding: 2.25rem 1rem; text-align: center; background: #fff;
    border: 1px dashed var(--c-control); border-radius: 14px; color: var(--c-muted);
  }
  .cwc-empty p { margin: 0 0 0.9rem; }
  .cwc-empty-title {
    font-family: var(--font-display, 'Fraunces', serif); font-size: 1.2rem; font-weight: 600;
    color: var(--c-navy); margin-bottom: 0.35rem !important;
  }

  /* Notes */
  .cwc-notes { margin-top: 2.5rem; font-size: 0.85rem; color: var(--c-muted); max-width: 46rem; }
  .cwc-notes p { margin: 0.75rem 0 0; }
  .cwc-legend summary { cursor: pointer; font-weight: 600; color: var(--c-navy); min-height: 32px; }
  .cwc-legend dl { margin: 0.5rem 0 0; display: grid; gap: 0.35rem; }
  .cwc-legend dl > div { display: grid; grid-template-columns: 6.5rem minmax(0, 1fr); gap: 0.5rem; }
  .cwc-legend dt { font-family: var(--font-mono, 'JetBrains Mono', monospace); font-weight: 700; color: var(--c-navy); }
  .cwc-legend dd { margin: 0; }

  /* Compact fixture list: reduce whitespace and keep teams/time aligned. */
  .day { margin-top: 1rem; }
  .day-title { background: #eaf6f1; border-left: 3px solid var(--c-coral); border-radius: 4px; padding: 0.45rem 0.75rem; color: var(--c-navy); font-size: 1rem; }
  .fx-list { margin-top: 0.25rem; gap: 0; }
  .fx { display: block; padding: 0.65rem 0.75rem; border: 0; border-bottom: 1px solid var(--c-line); border-radius: 0; background: transparent; }
  .fx[data-india='1'] { border-left: 0; padding-left: 0.75rem; }
  .fx-top { margin-bottom: 0.35rem; }
  .fx-main { grid-template-columns: minmax(0, 1fr) minmax(10rem, 0.9fr); gap: 1rem; }
  .fx-teams { display: flex; flex-wrap: wrap; align-items: center; justify-content: flex-start; gap: 0.65rem 1rem; max-width: none; }
  .team { display: flex; flex-direction: row; align-items: center; justify-content: flex-start; gap: 0.45rem; text-align: left; }
  .team-flag { display: block; width: 24px; height: 16px; object-fit: cover; border-radius: 2px; flex: none; box-shadow: 0 0 0 1px #00000012; }
  .team .code { width: auto; height: auto; min-width: 0; padding: 0.15rem 0.35rem; border-radius: 4px; font-size: 0.7rem; }
  .tname { font-size: 0.95rem; font-weight: 500; }
  .vs { padding: 0 0.1rem; }
  .fx-time { padding: 0; border: 0; min-width: 0; }
  .fx-foot { padding-top: 0.5rem; margin-top: 0.5rem; }
  .cwc-notes { margin-top: 1.25rem; }
  @media (max-width: 639px) {
    .fx-main { grid-template-columns: minmax(0, 1fr); gap: 0.6rem; }
    .fx-time { flex-direction: row; align-items: center; justify-content: flex-start; text-align: left; }
    .t-rows { flex-direction: row; align-items: baseline; }
  }

  /* Card alignment: teams left, broadcast centered, match times centered in right column. */
  .fx { position: relative; display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(9rem, 0.9fr) minmax(8.5rem, 0.65fr); align-items: center; column-gap: 1rem; row-gap: 0.35rem; padding: 0.7rem 0.75rem; }
  .fx[data-india='1'] { background: #f0faf5; border-left: 3px solid #b9e8d2; padding-left: 0.6rem; }
  .fx-top { grid-column: 1 / -1; margin-bottom: 0.1rem; }
  .fx-id { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.7rem; }
  .fx-venue-inline { color: var(--c-muted); font-family: var(--font-body, 'Inter', sans-serif); font-size: 0.8rem; letter-spacing: 0; text-transform: none; }
  .fx-main { display: contents; }
  .fx-teams { grid-column: 1; grid-row: 2; }
  .fx-solo-wrap { grid-column: 1; grid-row: 2; min-width: 0; }
  .fx-time { grid-column: 3; grid-row: 2; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; min-width: 0; padding: 0; border: 0; gap: 0.15rem; }
  .t-rows { display: flex; flex-direction: column; align-items: center; gap: 0.15rem; }
  .t-row { justify-content: center; gap: 0.35rem; }
  .t-lbl { display: none; }
  .t-val { font-size: 0.9rem; }
  .t-local .t-val { font-weight: 700; color: var(--c-navy); }
  .fx-broadcast { grid-column: 2; grid-row: 2; align-self: center; justify-self: center; text-align: left; min-width: 0; }
  .fx-stream-title { margin-bottom: 0.2rem !important; }
  .fx-stream .k { min-width: 3rem; }
  .fx-foot { display: none; }
  .fx-time .chip { display: none; }
  @media (max-width: 720px) {
    .fx { grid-template-columns: minmax(0, 1fr) minmax(7rem, auto); column-gap: 0.75rem; }
    .fx-teams, .fx-solo-wrap { grid-column: 1; grid-row: 2; }
    .fx-time { grid-column: 2; grid-row: 2; }
    .fx-broadcast { grid-column: 1 / -1; grid-row: 3; justify-self: start; margin-top: 0.25rem; }
  }
  @media (max-width: 420px) {
    .fx { padding: 0.65rem 0.5rem; }
    .fx-venue-inline { flex-basis: 100%; }
    .fx-teams { gap: 0.5rem; }
    .team { gap: 0.3rem; }
    .team-flag { width: 20px; height: 14px; }
    .t-val { font-size: 0.82rem; }
  }

  /* Make the timezone labels explicit and use the requested amber accent. */
  .t-lbl { display: inline !important; color: var(--c-muted); font-size: 0.68rem; font-weight: 700; letter-spacing: 0.04em; text-transform: uppercase; }
  .t-row { display: flex; align-items: baseline; justify-content: center; gap: 0.4rem; }
  .t-val { font-size: 0.9rem; font-weight: 700; color: var(--c-navy); }
  .t-local .t-val { font-weight: 700; color: var(--c-navy); }
  .fx-venue-inline { color: #c9820c !important; }
  .fx-stream .k { color: #c9820c !important; font-weight: 700; }
</style>

<script>
  type Field = 'q' | 'team' | 'stage' | 'group' | 'venue' | 'date' | 'slot' | 'india';
  const FIELDS: Field[] = ['q', 'team', 'stage', 'group', 'venue', 'date', 'slot', 'india'];
  const EXTRA: Field[] = ['team', 'stage', 'group', 'venue', 'date', 'slot'];
  type Control = HTMLInputElement | HTMLSelectElement;

  function initSchedule(root: HTMLElement) {
    const form = root.querySelector<HTMLFormElement>('[data-form]');
    const list = root.querySelector<HTMLElement>('[data-list]');
    const empty = root.querySelector<HTMLElement>('[data-empty]');
    const count = root.querySelector<HTMLElement>('[data-count]');
    const badge = root.querySelector<HTMLElement>('[data-badge]');
    const details = root.querySelector<HTMLDetailsElement>('[data-details]');
    const clearButtons = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-clear]'));
    if (!form || !list || !empty || !count) return;
    // Non-null aliases so TypeScript keeps the narrowing inside the functions below.
    const formEl: HTMLFormElement = form;
    const listEl: HTMLElement = list;
    const emptyEl: HTMLElement = empty;
    const countEl: HTMLElement = count;

    const cards = Array.from(root.querySelectorAll<HTMLElement>('[data-card]'));
    const dayGroups = Array.from(root.querySelectorAll<HTMLElement>('[data-day]'));
    const total = cards.length;
    const syncUrl = root.dataset.syncUrl === 'true';
    const control = (f: Field) => form.querySelector<Control>(`[data-f="${f}"]`);

    const read = (f: Field): string => {
      const el = control(f);
      if (!el) return '';
      if (el instanceof HTMLInputElement && el.type === 'checkbox') return el.checked ? '1' : '';
      return el.value.trim();
    };

    let urlTimer: number | undefined;
    const writeUrl = (v: Record<Field, string>) => {
      if (!syncUrl) return;
      window.clearTimeout(urlTimer);
      urlTimer = window.setTimeout(() => {
        try {
          const url = new URL(window.location.href);
          FIELDS.forEach((f) => (v[f] ? url.searchParams.set(f, v[f]) : url.searchParams.delete(f)));
          window.history.replaceState(null, '', url);
        } catch {
          /* history updates are optional */
        }
      }, 250);
    };

    function apply() {
      const v = {} as Record<Field, string>;
      FIELDS.forEach((f) => (v[f] = read(f)));
      const q = v.q.toLowerCase();
      const terms = q.split(/\s+/).filter(Boolean);
      // Search: exact phrase first ("qualifier a"); if nothing matches, fall back to every word starting a word.
      const run = (loose: boolean) => {
        let n = 0;
        for (const card of cards) {
          const d = card.dataset;
          const text = d.search ?? '';
          const ok =
            (!v.team || (d.teams ?? '').includes(` ${v.team} `)) &&
            (!v.stage || d.stage === v.stage) &&
            (!v.group || d.group === v.group) &&
            (!v.venue || d.venue === v.venue) &&
            (!v.date || d.date === v.date) &&
            (!v.slot || d.slot === v.slot) &&
            (!v.india || d.india === '1') &&
            (!q || (loose ? terms.every((t) => ` ${text}`.includes(` ${t}`)) : text.includes(q)));
          card.hidden = !ok;
          if (ok) n++;
        }
        return n;
      };
      let shown = run(false);
      if (shown === 0 && terms.length > 1) shown = run(true);
      dayGroups.forEach((g) => (g.hidden = !g.querySelector('[data-card]:not([hidden])')));

      countEl.textContent = `Showing ${shown} of ${total} fixtures`;
      emptyEl.hidden = shown > 0;
      listEl.hidden = shown === 0;

      const extra = EXTRA.filter((f) => v[f]).length;
      const any = extra + (v.q ? 1 : 0) + (v.india ? 1 : 0);
      if (badge) {
        badge.textContent = String(extra);
        badge.hidden = extra === 0;
      }
      clearButtons.forEach((b) => b.setAttribute('aria-disabled', any === 0 ? 'true' : 'false'));
      writeUrl(v);
      return { extra, any };
    }

    function clearAll() {
      formEl.reset();
      apply();
    }

    // Restore filters from the URL (only values that exist as options).
    if (syncUrl) {
      const params = new URLSearchParams(window.location.search);
      FIELDS.forEach((f) => {
        const val = params.get(f);
        const el = control(f);
        if (!val || !el) return;
        if (el instanceof HTMLInputElement) {
          if (el.type === 'checkbox') el.checked = val === '1';
          else el.value = val;
        } else if (Array.from(el.options).some((o) => o.value === val)) {
          el.value = val;
        }
      });
    }

    form.addEventListener('submit', (e) => e.preventDefault());
    form.addEventListener('input', apply);
    form.addEventListener('change', apply);
    clearButtons.forEach((b) =>
      b.addEventListener('click', () => {
        if (b.getAttribute('aria-disabled') === 'true') return;
        clearAll();
      })
    );

    const state = apply();
    // Filter panel: open on larger screens, collapsed on phones unless filters are active.
    if (details) details.open = window.matchMedia('(min-width: 768px)').matches || state.extra > 0;
  }

  document.querySelectorAll<HTMLElement>('[data-cwc-schedule]').forEach(initSchedule);
</script>