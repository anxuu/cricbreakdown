---
interface Props {
  src: string;
  alt: string;
}

const { src, alt } = Astro.props;
---

<figure class="blog-cover">
  <img
    src={src}
    alt={alt}
    width="1478"
    height="656"
    loading="eager"
    decoding="async"
  />
</figure>

<style>
  .blog-cover {
    max-width: 840px;
    width: 100%;
    aspect-ratio: 1478 / 656;
    margin: 24px auto 40px;
    overflow: hidden;
    border-radius: 24px;
    background: #0a1a1c;
  }

  .blog-cover img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center center;
  }
</style>
