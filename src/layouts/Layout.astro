---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  type?: 'website' | 'article';
  author?: string;
  authorUrl?: string;
  publishedTime?: string;
  modifiedTime?: string;
  category?: string;
  keywords?: string[];
  image?: string;
  imageAlt?: string;
  imageWidth?: number;
  imageHeight?: number;
  readTime?: number;
}

const {
  title,
  description,
  canonical,
  type = 'website',
  author,
  authorUrl,
  publishedTime,
  modifiedTime,
  category,
  keywords = [],
  image,
  imageAlt,
  imageWidth,
  imageHeight,
  readTime,
} = Astro.props;

const siteName = 'CricBreakdown';
const siteUrl = 'https://www.cricbreakdown.com';
const normalizedPath = Astro.url.pathname === '/' ? '/' : Astro.url.pathname.replace(/\/$/, '');
const canonicalUrl = canonical ?? new URL(normalizedPath, siteUrl).href;
const absoluteImage = image ? new URL(image, siteUrl).href : undefined;
const fullTitle = `${title} · ${siteName}`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/images/mark.svg" />
    <link rel="canonical" href={canonicalUrl} />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    {author && <meta name="author" content={author} />}
    {authorUrl && <link rel="author" href={authorUrl} />}
    {category && <meta property="article:section" content={category} />}
    {keywords.length > 0 && <meta name="keywords" content={keywords.join(', ')} />}
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}

    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={siteName} />
    {author && <meta property="article:author" content={author} />}
    {absoluteImage && <meta property="og:image" content={absoluteImage} />}
    {absoluteImage && imageAlt && <meta property="og:image:alt" content={imageAlt} />}
    {absoluteImage && imageWidth && <meta property="og:image:width" content={String(imageWidth)} />}
    {absoluteImage && imageHeight && <meta property="og:image:height" content={String(imageHeight)} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    {absoluteImage && <meta name="twitter:image" content={absoluteImage} />}
    {absoluteImage && imageAlt && <meta name="twitter:image:alt" content={imageAlt} />}

    {readTime !== undefined && <meta name="article:reading_time" content={`${readTime} minutes`} />}
  </head>
  <body class="min-h-screen flex flex-col">
    <header class="sticky top-0 z-50 bg-[#1A1A2E] shadow-sm">
      <div class="max-w-6xl mx-auto px-5 md:px-8 flex items-center justify-between h-20">
        <a href="/" class="flex items-center" aria-label="CricBreakdown home">
          <img src="/images/logo.svg" alt="CricBreakdown" class="h-8 md:h-9 w-auto brightness-0 invert" />
        </a>

        <nav class="hidden md:flex items-center gap-6 font-medium text-sm" aria-label="Primary navigation">
          <a href="/articles" class="text-white/80 hover:text-white transition-colors">Breakdowns</a>
          <a href="/category/ipl" class="text-white/80 hover:text-white transition-colors">IPL</a>
          <a href="/category/international" class="text-white/80 hover:text-white transition-colors">International</a>
          <a href="/category/history" class="text-white/80 hover:text-white transition-colors">Chronicles</a>
          <a href="/about" class="text-white/80 hover:text-white transition-colors">About Us</a>
          <a href="/write-for-us" class="bg-[#E94560] text-white px-4 py-2 rounded-md hover:bg-[#C73652] transition-colors">Write for Us</a>
        </nav>

        <button
          id="hamburger"
          type="button"
          class="md:hidden inline-flex flex-col justify-center gap-0 w-10 h-10 p-2 rounded-md hover:bg-white/10"
          aria-label="Open navigation menu"
          aria-expanded="false"
          aria-controls="mobile-menu"
        >
          <span id="bar1" class="block h-0.5 w-6 bg-white transition-transform"></span>
          <span id="bar2" class="block h-0.5 w-6 bg-white transition-opacity my-[5px]"></span>
          <span id="bar3" class="block h-0.5 w-6 bg-white transition-transform"></span>
        </button>
      </div>

      <div id="mobile-menu">
        <a href="/articles">Breakdowns</a>
        <a href="/category/ipl">IPL</a>
        <a href="/category/international">International</a>
        <a href="/category/history">Chronicles</a>
        <a href="/about">About Us</a>
        <a href="/write-for-us">Write for Us</a>
      </div>
      <div class="seam"></div>
    </header>

    <main class="flex-1">
      <slot />
    </main>

    <footer class="bg-[#1A1A2E] text-white/80 mt-24">
      <div class="max-w-6xl mx-auto px-5 md:px-8 py-14 grid gap-10 md:grid-cols-4">
        <div class="md:col-span-2">
          <img src="/images/logo.svg" alt="CricBreakdown" class="h-8 w-auto mb-4 brightness-0 invert opacity-90" />
          <p class="text-sm leading-relaxed max-w-sm text-white/60">
            Cricket, taken apart. Stat breakdowns, team deep-dives and history
            for readers who want more than a scoreline. Unofficial fan content —
            not affiliated with the BCCI, ICC, or any franchise.
          </p>
        </div>
        <div>
          <h2 class="font-display text-sm tracking-wide text-[#E94560] mb-4">Explore</h2>
          <ul class="space-y-2 text-sm text-white/70">
            <li><a href="/" class="hover:text-white transition-colors">Home</a></li>
            <li><a href="/articles" class="hover:text-white transition-colors">All breakdowns</a></li>
            <li><a href="/category/ipl" class="hover:text-white transition-colors">IPL</a></li>
            <li><a href="/category/international" class="hover:text-white transition-colors">International</a></li>
            <li><a href="/category/history" class="hover:text-white transition-colors">Cricket Chronicles</a></li>
          </ul>
        </div>
        <div>
          <h2 class="font-display text-sm tracking-wide text-[#E94560] mb-4">Site</h2>
          <ul class="space-y-2 text-sm text-white/70">
            <li><a href="/about" class="hover:text-white transition-colors">About Us</a></li>
            <li><a href="/write-for-us" class="hover:text-white transition-colors">Write for Us</a></li>
            <li><a href="/contact" class="hover:text-white transition-colors">Contact</a></li>
            <li><a href="/privacy-policy" class="hover:text-white transition-colors">Privacy policy</a></li>
            <li><a href="/terms" class="hover:text-white transition-colors">Terms</a></li>
          </ul>
        </div>
      </div>
      <div class="border-t border-white/10 py-5 text-center text-xs text-white/40">
        © {new Date().getFullYear()} CricBreakdown. All rights reserved.
      </div>
    </footer>

    <script>
      const btn = document.getElementById('hamburger');
      const menu = document.getElementById('mobile-menu');
      const bar1 = document.getElementById('bar1');
      const bar2 = document.getElementById('bar2');
      const bar3 = document.getElementById('bar3');
      btn?.addEventListener('click', () => {
        const isOpen = menu?.classList.toggle('open');
        btn.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
        btn.setAttribute('aria-label', isOpen ? 'Close navigation menu' : 'Open navigation menu');
        if (isOpen) {
          if (bar1) bar1.style.transform = 'translateY(7px) rotate(45deg)';
          if (bar2) bar2.style.opacity = '0';
          if (bar3) bar3.style.transform = 'translateY(-7px) rotate(-45deg)';
        } else {
          if (bar1) bar1.style.transform = '';
          if (bar2) bar2.style.opacity = '1';
          if (bar3) bar3.style.transform = '';
        }
      });
      menu?.querySelectorAll('a').forEach(link => {
        link.addEventListener('click', () => {
          menu.classList.remove('open');
          btn?.setAttribute('aria-expanded', 'false');
          btn?.setAttribute('aria-label', 'Open navigation menu');
          if (bar1) bar1.style.transform = '';
          if (bar2) bar2.style.opacity = '1';
          if (bar3) bar3.style.transform = '';
        });
      });
    </script>
  </body>
</html>
